---
import { noticias } from "../data/site";

const data = (iso: string) =>
  new Intl.DateTimeFormat("pt-BR", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }).format(new Date(iso));
const [destaque, ...demais] = noticias;
---

<section class="noti" id="noticias" aria-labelledby="noti-titulo">
  <div class="wrap">
    <h2 id="noti-titulo" class="titulo h2">Notícias</h2>
    <div class="noti__grid">
      <article class="noti__destaque">
        <a href={destaque.href}>
          <img src={`${destaque.foto}-800.webp`} srcset={`${destaque.foto}-800.webp 800w, ${destaque.foto}-1600.webp 1200w`} sizes="(min-width: 960px) 50vw, 100vw" width="1200" height="800" alt="" loading="lazy" />
          <time datetime={destaque.data}>{data(destaque.data)}</time>
          <h3>{destaque.titulo}</h3>
          <p>{destaque.resumo}</p>
        </a>
      </article>
      <ul role="list" class="noti__lista">
        {
          demais.map((n) => (
            <li>
              <a href={n.href}>
                <time datetime={n.data}>{data(n.data)}</time>
                <h3>{n.titulo}</h3>
                <p>{n.resumo}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .noti {
    padding-block: clamp(4rem, 2rem + 7vw, 8rem);
  }

  .noti__grid {
    margin-top: clamp(2rem, 1rem + 3vw, 3rem);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 2.5rem var(--gutter);
  }

  .noti a {
    display: block;
    text-decoration: none;
  }

  .noti__destaque {
    grid-column: 1 / span 6;
  }

  .noti__destaque img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    margin-bottom: 1.25rem;
  }

  .noti time {
    font-size: var(--t-14);
    color: var(--tinta-2);
  }

  .noti h3 {
    margin-top: 0.375rem;
    font-size: var(--t-20);
    font-weight: 700;
    line-height: 1.3;
    color: var(--grafite);
  }

  .noti__destaque h3 {
    font-size: var(--t-24);
  }

  .noti p {
    margin-top: 0.5rem;
    color: var(--tinta-2);
  }

  .noti a:hover h3 {
    color: var(--petroleo-700);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .noti__lista {
    grid-column: 8 / span 5;
    border-top: 1px solid var(--tinta);
  }

  .noti__lista li {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--filete);
  }

  @media (max-width: 959px) {
    .noti__destaque,
    .noti__lista {
      grid-column: 1 / -1;
    }
  }
</style>
