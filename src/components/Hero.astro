---
import { HERO_VIDEO, temas } from "../data/site";

// Mosaico 4 x 4 no ritmo do painel da marca: fotos recortadas por módulos e módulos de cor.
// As fotos nunca giram (só os módulos de cor giram), para ficarem sempre na orientação certa.
type Peca =
  | { tipo: "foto"; c: number; r: number; tam?: 2; forma: string }
  | { tipo: "cor"; c: number; r: number; forma: string; cor: string; fundo: string; giro: number };
const pecas: Peca[] = [
  { tipo: "foto", c: 1, r: 1, forma: "quarto-sd" },
  { tipo: "cor", c: 2, r: 1, forma: "anel", cor: "var(--gelo)", fundo: "var(--grafite-600)", giro: 0 },
  { tipo: "foto", c: 3, r: 1, tam: 2, forma: "folha-grande" },
  { tipo: "cor", c: 1, r: 2, forma: "triangulo", cor: "var(--petroleo)", fundo: "transparent", giro: 0 },
  { tipo: "foto", c: 2, r: 2, forma: "folha-id" },
  { tipo: "foto", c: 1, r: 3, forma: "circulo" },
  { tipo: "cor", c: 2, r: 3, forma: "listras", cor: "var(--gelo)", fundo: "transparent", giro: 0 },
  { tipo: "foto", c: 3, r: 3, forma: "quarto-se" },
  { tipo: "cor", c: 4, r: 3, forma: "quarto", cor: "var(--petroleo)", fundo: "transparent", giro: 180 },
  { tipo: "cor", c: 1, r: 4, forma: "folha", cor: "var(--gelo)", fundo: "transparent", giro: 180 },
  { tipo: "foto", c: 2, r: 4, forma: "quarto-id" },
  { tipo: "cor", c: 3, r: 4, forma: "ponto", cor: "var(--petroleo)", fundo: "var(--grafite-600)", giro: 0 },
  { tipo: "foto", c: 4, r: 4, forma: "folha-se" },
];
let n = 0;
const indicePeca = pecas.map((p) => (p.tipo === "foto" && p.tam !== 2 ? n++ : -1));
const primeiro = temas[0];
---

<section class="hero" aria-labelledby="hero-titulo" data-hero>
  <div class="hero__texto">
    <h1 id="hero-titulo" class="titulo hero__titulo">
      Uma escola{" "}
      {
        temas.map((t, i) => (
          <Fragment>
            <span class="hero__grupo"><button type="button" class="hero__palavra" data-ir={i} aria-pressed={i === 0 ? "true" : "false"}>{t.palavra}</button>{i === 0 ? "," : i === 2 ? "." : ""}</span>{i === 1 ? " e " : i === 0 ? " " : ""}
          </Fragment>
        ))
      }
    </h1>

    <div class="hero__legendas so-desktop">
      {
        temas.map((t, i) => (
          <p class="hero__legenda" data-legenda={i} aria-hidden={i === 0 ? "false" : "true"}>
            {t.legenda} <a class="hero__ver" href={t.link.href} tabindex={i === 0 ? 0 : -1}>{t.link.rotulo}</a>
          </p>
        ))
      }
    </div>

    <div class="hero__acoes">
      <a class="botao" href="#visita">Agendar uma visita</a>
      <a class="hero__link so-desktop" href="#etapas">Ver as etapas de ensino</a>
    </div>
  </div>

  <!-- celular: uma foto grande por tema, sem mosaico; a marca entra só no quarto de círculo do canto -->
  <div class="hero__foto-movel" aria-hidden="true">
    {
      temas.map((t, i) => (
        <img
          class:list={["hero__foto-movel-img", { ativa: i === 0 }]}
          data-movel={i}
          src={`${t.grande.src}-800.webp`}
          srcset={`${t.grande.src}-800.webp 800w, ${t.grande.src}-1600.webp 1600w`}
          sizes="100vw"
          style={`object-position:${t.grande.foco}`}
          alt=""
          loading={i === 0 ? "eager" : "lazy"}
          decoding="async"
        />
      ))
    }
    <span class="hero__canto" />
  </div>

  <div class="mosaico" data-mosaico>
    {
      pecas.map((p, i) =>
        p.tipo === "foto" ? (
          <span
            class:list={["peca", "peca--foto", `forma-${p.forma}`, { "peca--grande": p.tam === 2 }]}
            style={`grid-column:${p.c} / span ${p.tam ?? 1};grid-row:${p.r} / span ${p.tam ?? 1}`}
            data-foto={p.tam === 2 ? "grande" : indicePeca[i]}
          >
            <span class="peca__forma">
              {p.tam === 2 && HERO_VIDEO ? (
                <video class="peca__video" src={HERO_VIDEO.src} poster={HERO_VIDEO.poster} autoplay muted loop playsinline />
              ) : p.tam === 2 ? (
                <>
                  <img
                    class="peca__img ativa"
                    src={`${primeiro.grande.src}-1600.webp`}
                    srcset={`${primeiro.grande.src}-800.webp 800w, ${primeiro.grande.src}-1600.webp 1600w`}
                    sizes="(min-width: 1101px) 30vw, 50vw"
                    style={`object-position:${primeiro.grande.foco}`}
                    alt={primeiro.grande.alt}
                    fetchpriority="high"
                  />
                  <img class="peca__img" alt="" decoding="async" />
                </>
              ) : (
                <>
                  <img class="peca__img ativa" src={primeiro.fotos[indicePeca[i]]} alt="" decoding="async" />
                  <img class="peca__img" alt="" decoding="async" />
                </>
              )}
            </span>
          </span>
        ) : (
          <span
            class:list={["peca", "peca--cor", `forma-${p.forma}`]}
            style={`grid-column:${p.c};grid-row:${p.r};--giro:${p.giro}deg;--cor:${p.cor};--fundo:${p.fundo}`}
            aria-hidden="true"
          >
            <span class="peca__forma" />
          </span>
        ),
      )
    }
  </div>

  <script type="application/json" data-temas set:html={JSON.stringify(temas)} />
</section>

<script>
  interface Tema {
    id: string;
    palavra: string;
    legenda: string;
    link: { rotulo: string; href: string };
    grande: { src: string; foco: string; alt: string };
    fotos: string[];
  }
  const hero = document.querySelector<HTMLElement>("[data-hero]")!;
  const temas: Tema[] = JSON.parse(hero.querySelector("[data-temas]")!.textContent!);
  const reduzir = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const legendas = [...hero.querySelectorAll<HTMLElement>("[data-legenda]")];
  const botoes = [...hero.querySelectorAll<HTMLButtonElement>("[data-ir]")];
  const pecas = [...hero.querySelectorAll<HTMLElement>("[data-foto]")];
  const INTERVALO = 3800;
  const celular = matchMedia("(max-width: 760px)");
  const fotosMovel = [...hero.querySelectorAll<HTMLImageElement>("[data-movel]")];

  let atual = 0;
  let parado = reduzir;
  let relogio = 0;

  const carregar = (t: Tema) => {
    [...t.fotos, `${t.grande.src}-1600.webp`].forEach((f) => (new Image().src = f));
  };

  function trocar(p: HTMLElement, src: string, atraso: number, foco?: string, alt?: string) {
    const imgs = p.querySelectorAll<HTMLImageElement>(".peca__img");
    if (imgs.length < 2) return;
    const [a, b] = imgs[0].classList.contains("ativa") ? [imgs[0], imgs[1]] : [imgs[1], imgs[0]];
    setTimeout(() => {
      b.removeAttribute("srcset");
      b.src = src;
      b.style.objectPosition = foco ?? "";
      b.alt = alt ?? "";
      a.alt = "";
      const mostrar = () => {
        b.classList.add("ativa");
        a.classList.remove("ativa");
      };
      b.complete ? mostrar() : b.addEventListener("load", mostrar, { once: true });
    }, atraso);
  }

  function ir(i: number, manual = false) {
    atual = (i + temas.length) % temas.length;
    const t = temas[atual];
    botoes.forEach((b, k) => b.setAttribute("aria-pressed", String(k === atual)));
    legendas.forEach((l, k) => {
      l.setAttribute("aria-hidden", String(k !== atual));
      l.querySelector("a")!.tabIndex = k === atual ? 0 : -1;
    });
    fotosMovel.forEach((f, k) => f.classList.toggle("ativa", k === atual));
    // no celular o mosaico está oculto: não baixa as fotos dele
    if (!celular.matches) pecas.forEach((p, k) => {
      const atraso = reduzir ? 0 : k * 70;
      if (p.dataset.foto === "grande") trocar(p, `${t.grande.src}-1600.webp`, atraso, t.grande.foco, t.grande.alt);
      else trocar(p, t.fotos[Number(p.dataset.foto) % t.fotos.length], atraso);
    });
    if (!celular.matches) carregar(temas[(atual + 1) % temas.length]);
    reiniciar(manual);
  }

  function reiniciar(manual = false) {
    clearTimeout(relogio);
    hero.style.setProperty("--intervalo", `${INTERVALO}ms`);
    hero.classList.remove("contando");
    void hero.offsetWidth;
    if (parado) return;
    hero.classList.add("contando");
    relogio = window.setTimeout(() => ir(atual + 1), manual ? INTERVALO * 1.6 : INTERVALO);
  }

  // a troca é automática; escolher uma palavra só recomeça a contagem a partir dela
  botoes.forEach((b) => b.addEventListener("click", () => ir(Number(b.dataset.ir), true)));

  // os módulos de cor giram quando o cursor passa; as fotos ficam paradas
  if (!reduzir) {
    hero.querySelectorAll<HTMLElement>(".peca--cor").forEach((p) => {
      let g = 0;
      p.addEventListener("pointerenter", () => {
        g += 90;
        p.style.setProperty("--extra", `${g}deg`);
      });
    });
  }

  new IntersectionObserver(([e]) => {
    if (!e.isIntersecting) (clearTimeout(relogio), hero.classList.remove("contando"));
    else reiniciar();
  }).observe(hero);
  document.addEventListener("visibilitychange", () => (document.hidden ? clearTimeout(relogio) : reiniciar()));

  if (!celular.matches) carregar(temas[1]);
  reiniciar();
</script>

<style>
  .hero {
    --altura: clamp(560px, min(calc(100svh - var(--header-h)), 56vw), 860px);
    --m: clamp(10px, 1.1vw, 16px);
    position: relative;
    /* moldura branca arredondada; a mesma medida é usada pelo menu em Header.astro */
    clip-path: inset(0 var(--m) var(--m) round calc(2.25 * var(--m)));
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--altura);
    min-height: var(--altura);
    background: var(--grafite);
    color: var(--branco);
    overflow: hidden;
  }

  .hero__texto {
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* a caixa de texto (até 36rem) fica centrada entre a borda da hero e o mosaico */
    --pad: clamp(1.5rem, 1rem + 3vw, 4rem);
    padding: clamp(2.5rem, 1rem + 4vw, 4.5rem) max(var(--pad), calc((100% - 36rem) / 2)) 2rem;
  }

  .hero__titulo {
    font-size: clamp(2.5rem, 4.3vw, 4.75rem);
    line-height: 1.02;
  }

  .hero__grupo {
    white-space: nowrap;
  }

  /* cada palavra do slogan é um botão: a ativa em branco, as outras esmaecidas */
  .hero__palavra {
    display: inline;
    padding: 0;
    border: 0;
    background: none;
    color: rgb(255 255 255 / 0.38);
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
    transition: color 320ms var(--ease);
  }

  .hero__palavra:hover {
    color: rgb(255 255 255 / 0.7);
  }

  .hero__palavra[aria-pressed="true"] {
    color: var(--branco);
  }


  /* as três legendas ficam empilhadas na mesma célula: a altura é sempre a da maior, sem salto de layout */
  .hero__legendas {
    display: grid;
    margin-top: 1.5rem;
    max-width: 30em;
  }

  .hero__legenda {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 300ms var(--ease),
      transform 300ms var(--ease);
    pointer-events: none;
  }

  .hero__legenda[aria-hidden="false"] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .hero__legenda {
    font-size: var(--t-18);
    color: #c6d0d2;
    line-height: 1.5;
  }

  .hero__ver {
    border: 0;
    background: none;
    padding: 0.25rem 0;
    color: var(--petroleo-claro);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }



  .hero__acoes {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  .hero .botao {
    background: var(--petroleo);
    color: var(--grafite-900);
  }

  .hero .botao:hover {
    background: var(--petroleo-claro);
  }

  .hero__link {
    color: var(--branco);
    font-weight: 600;
    text-underline-offset: 0.25em;
  }



  /* ---------- mosaico */
  .mosaico {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(4, 1fr);
    height: var(--altura);
    width: var(--altura);
  }

  .peca {
    --extra: 0deg;
    position: relative;
    display: block;
    padding: 0;
    border: 0;
    background: var(--fundo, transparent);
    overflow: hidden;
  }

  .peca--foto {
    cursor: pointer;
  }

  .peca__forma {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transform: rotate(calc(var(--giro) + var(--extra)));
    transition: transform 520ms var(--ease);
  }

  .peca--cor .peca__forma {
    background: var(--cor);
  }

  /* a foto gira junto com o módulo e volta na direção oposta, para ficar sempre de pé */
  .peca__img,
  .peca__video {
    position: absolute;
    inset: -21%;
    width: 142%;
    height: 142%;
    max-width: none;
    object-fit: cover;
    opacity: 0;
    transform: rotate(calc(-1 * (var(--giro) + var(--extra))));
    transition:
      transform 520ms var(--ease),
      opacity 380ms var(--ease);
  }

  .peca__img.ativa,
  .peca__video {
    opacity: 1;
  }

  .forma-quarto .peca__forma {
    border-top-right-radius: 100%;
  }
  .forma-folha .peca__forma {
    border-top-right-radius: 50%;
  }
  .forma-folha-grande .peca__forma {
    border-top-left-radius: 50%;
  }
  .forma-circulo .peca__forma,
  .forma-ponto .peca__forma {
    border-radius: 50%;
  }
  .forma-ponto .peca__forma {
    inset: 28%;
  }
  .forma-anel .peca__forma {
    inset: 14%;
    border-radius: 50%;
    background: none !important;
    border: calc(var(--altura) / 4 * 0.16) solid var(--cor);
  }
  .forma-triangulo .peca__forma {
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }
  .forma-listras .peca__forma {
    background: repeating-linear-gradient(-45deg, var(--cor) 0 9%, transparent 9% 20%) !important;
  }

  /* fotos: recorte fixo, sem giro, sempre de pé */
  .peca--foto .peca__forma,
  .peca--foto .peca__img {
    transform: none;
  }

  .peca--foto .peca__img {
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .forma-quarto-sd .peca__forma { border-top-right-radius: 100%; }
  .forma-quarto-se .peca__forma { border-top-left-radius: 100%; }
  .forma-quarto-id .peca__forma { border-bottom-right-radius: 100%; }
  .forma-folha-id .peca__forma { border-bottom-right-radius: 50%; }
  .forma-folha-se .peca__forma { border-top-left-radius: 50%; }

  @media (max-width: 1100px) {
    .hero__titulo {
      font-size: clamp(2.25rem, 9.6vw, 4.5rem);
    }
    .hero {
      --altura: min(100vw, 620px);
      grid-template-columns: minmax(0, 1fr);
    }
    .hero__texto {
      padding-inline: var(--gutter);
    }
    .mosaico {
      width: 100%;
      height: auto;
      aspect-ratio: 1;
      max-width: 620px;
      margin-inline: auto;
    }
  }

  .hero__foto-movel {
    display: none;
  }

  /* celular: fotos primeiro, sem moldura, só o título e o botão */
  @media (max-width: 760px) {
    .hero {
      clip-path: none;
      min-height: 0;
    }
    .mosaico {
      display: none;
    }
    .hero__foto-movel {
      order: -1;
      position: relative;
      display: block;
      aspect-ratio: 4 / 5;
      max-height: 68svh;
      width: 100%;
      overflow: hidden;
      background: var(--grafite-800);
    }
    .hero__foto-movel-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transform: scale(1.04);
      transition:
        opacity 600ms var(--ease),
        transform 3800ms linear;
    }
    .hero__foto-movel-img.ativa {
      opacity: 1;
      transform: scale(1);
    }
    /* o único elemento da marca: um quarto de círculo petróleo que liga a foto ao título */
    .hero__canto {
      position: absolute;
      left: 0;
      bottom: 0;
      width: 76px;
      height: 76px;
      background: var(--petroleo);
      border-top-right-radius: 100%;
    }
    .hero__texto {
      padding-block: 1.5rem 2rem;
    }
    .hero__titulo {
      font-size: clamp(2.25rem, 11vw, 3.25rem);
    }
    .so-desktop {
      display: none;
    }
    .hero__acoes {
      margin-top: 1.25rem;
    }
    .hero__acoes .botao {
      width: 100%;
    }
  }
</style>
