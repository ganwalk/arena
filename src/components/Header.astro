---
import { acessos } from "../data/site";

const links = [
  { rotulo: "Etapas de ensino", href: "#etapas" },
  { rotulo: "Arena pelo mundo", href: "#mundo" },
  { rotulo: "Proposta", href: "#proposta" },
  { rotulo: "Notícias", href: "#noticias" },
  { rotulo: "Unidades", href: "#visita" },
];
---

<header class="topo" data-topo>
  <svg class="topo__liquido" aria-hidden="true" focusable="false">
    <path data-corpo fill="#fff" />
  </svg>
  <div class="wrap topo__barra">
    <a class="topo__marca" href="/" aria-label="Colégio Arena, página inicial">
      <img src="/brand/arena.svg" alt="Colégio Arena" width="120" height="43" />
    </a>

    <nav class="topo__nav" aria-label="Principal">
      <ul role="list">
        {links.map((l) => <li><a href={l.href}>{l.rotulo}</a></li>)}
        <li>
          <details class="acesso">
            <summary>Área do aluno</summary>
            <ul role="list" class="acesso__lista">
              {acessos.map((a) => <li><a href={a.href} rel="noopener">{a.rotulo}</a></li>)}
            </ul>
          </details>
        </li>
      </ul>
    </nav>

    <div class="topo__acoes">
      <a class="botao topo__cta" href="#visita">Agendar visita</a>
      <button class="topo__menu" type="button" aria-expanded="false" aria-controls="menu-movel" data-menu>
        <span class="sr-only">Abrir menu</span>
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>

  <div class="movel" id="menu-movel" hidden>
    <nav class="wrap" aria-label="Menu">
      <ul role="list">
        {links.map((l) => <li><a href={l.href}>{l.rotulo}</a></li>)}
      </ul>
      <p class="movel__rotulo">Área do aluno</p>
      <ul role="list" class="movel__acessos">
        {acessos.map((a) => <li><a href={a.href} rel="noopener">{a.rotulo}</a></li>)}
      </ul>
      <a class="botao" href="#visita">Agendar visita</a>
    </nav>
  </div>
</header>

<script>
  // Rolagem com mola: o valor exibido persegue o da rolagem com inércia e um leve balanço, como um fluido.
  const raiz = document.documentElement;
  const topo = document.querySelector<HTMLElement>("[data-topo]")!;
  const svg = topo.querySelector<SVGSVGElement>(".topo__liquido")!;
  const corpo = svg.querySelector<SVGPathElement>("[data-corpo]")!;
  const barra = topo.querySelector<HTMLElement>(".topo__barra")!;
  const reduzirMov = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const DISTANCIA = 220;

  let x = Math.min(1, scrollY / DISTANCIA);
  let v = 0;
  let quadro = 0;
  let limites = { W: 0, L: 0, R: 0, H: 72, m: 16 };
  const semMoldura = matchMedia("(max-width: 760px)");

  const medir = () => {
    const b = barra.getBoundingClientRect();
    const pad = parseFloat(getComputedStyle(barra).paddingLeft);
    // mesma medida da moldura da hero (Hero.astro: --m = clamp(10px, 1.1vw, 16px))
    const m = semMoldura.matches ? 0 : Math.min(16, Math.max(10, innerWidth * 0.011));
    limites = { W: topo.clientWidth, L: b.left + pad - 18, R: b.right - pad + 8, H: b.height, m };
  };
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

  /*
    Uma única forma branca. Em repouso é uma faixa de borda a borda (branco sobre o branco da página, sob a
    moldura da hero). Ao rolar, as laterais recuam, a base sobe e os cantos arredondam até virar a pílula.
  */
  const n = (v: number) => v.toFixed(2);
  const suaviza = (t: number) => t * t * (3 - 2 * t);
  function forma(x1: number, x2: number, y1: number, y2: number, c: number) {
    const k = Math.min(c, (y2 - y1) / 2, (x2 - x1) / 2);
    return [
      `M${n(x1 + k)} ${n(y1)}H${n(x2 - k)}`,
      `A${n(k)} ${n(k)} 0 0 1 ${n(x2)} ${n(y1 + k)}V${n(y2 - k)}`,
      `A${n(k)} ${n(k)} 0 0 1 ${n(x2 - k)} ${n(y2)}H${n(x1 + k)}`,
      `A${n(k)} ${n(k)} 0 0 1 ${n(x1)} ${n(y2 - k)}V${n(y1 + k)}`,
      `A${n(k)} ${n(k)} 0 0 1 ${n(x1 + k)} ${n(y1)}Z`,
    ].join("");
  }

  function pintar() {
    const { W, L, R, H } = limites;
    const r = Math.max(0, Math.min(1, x));
    raiz.style.setProperty("--rolagem", r.toFixed(4));
    const t = suaviza(r);
    corpo.setAttribute("d", forma(lerp(0, L, t), lerp(W, R, t), lerp(0, 8, t), lerp(H, H - 8, t), lerp(0, 22, t)));
    const sombra = Math.max(0, (r - 0.5) / 0.5);
    svg.style.filter = sombra
      ? `drop-shadow(0 0 0.6px rgba(28,37,41,${(0.4 * sombra).toFixed(3)})) drop-shadow(0 6px 10px rgba(28,37,41,${(0.12 * sombra).toFixed(3)}))`
      : "none";
  }

  // mola calibrada para 60 quadros/s (sem balanço, acompanha a rolagem com um leve atraso); em telas mais rápidas, subpassos
  let antes = 0;
  function passo(agora: number) {
    quadro = 0;
    const alvo = Math.min(1, Math.max(0, scrollY / DISTANCIA));
    if (reduzirMov) {
      x = alvo;
      v = 0;
    } else {
      const passos = antes ? Math.min(4, Math.max(1, Math.round((agora - antes) / 16.7))) : 1;
      for (let i = 0; i < passos; i++) {
        v = v * 0.7 + (alvo - x) * 0.045;
        x += v;
      }
    }
    antes = agora;
    pintar();
    if (Math.abs(v) > 0.0003 || Math.abs(alvo - x) > 0.0003) quadro = requestAnimationFrame(passo);
    else antes = 0;
  }
  const pedir = () => (quadro ||= requestAnimationFrame(passo));

  medir();
  pintar();
  addEventListener("scroll", pedir, { passive: true });
  addEventListener("resize", () => {
    medir();
    pintar();
  });
  document.fonts?.ready.then(() => {
    medir();
    pintar();
  });

  const botao = document.querySelector<HTMLButtonElement>("[data-menu]");
  const painel = document.getElementById("menu-movel");
  if (botao && painel) {
    const fechar = () => {
      botao.setAttribute("aria-expanded", "false");
      botao.querySelector(".sr-only")!.textContent = "Abrir menu";
      painel.hidden = true;
    };
    botao.addEventListener("click", () => {
      const aberto = botao.getAttribute("aria-expanded") === "true";
      if (aberto) return fechar();
      botao.setAttribute("aria-expanded", "true");
      botao.querySelector(".sr-only")!.textContent = "Fechar menu";
      painel.hidden = false;
    });
    painel.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) fechar();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !painel.hidden) {
        fechar();
        botao.focus();
      }
    });
  }

  document.addEventListener("click", (e) => {
    document.querySelectorAll<HTMLDetailsElement>("details.acesso[open]").forEach((d) => {
      if (!d.contains(e.target as Node)) d.open = false;
    });
  });
</script>

<style>
  /*
    O cabeçalho começa como a faixa de cima da moldura branca da hero e, ao rolar, se contrai continuamente até
    virar uma pílula flutuante. A forma é desenhada no SVG .topo__liquido pelo script abaixo.
  */
  .topo {
    --r: var(--rolagem, 0);
    position: sticky;
    top: 0;
    z-index: 50;
    isolation: isolate;
  }

  .topo__liquido {
    position: absolute;
    z-index: -1;
    left: 0;
    top: 0;
    width: 100%;
    height: calc(var(--header-h) + 48px);
    overflow: visible;
    pointer-events: none;
  }

  /* marca à esquerda, navegação centralizada, CTA à direita */
  .topo__barra {
    position: relative;
    height: var(--header-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
  }

  .topo__marca {
    justify-self: start;
  }

  .topo__marca img {
    width: 112px;
    height: auto;
  }

  .topo__nav > ul {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .topo__nav a,
  .acesso summary {
    font-size: var(--t-14);
    font-weight: 550;
    text-decoration: none;
    color: var(--tinta);
    padding-block: 0.75rem;
  }

  .topo__nav a:hover,
  .acesso summary:hover {
    color: var(--petroleo-700);
  }

  .topo__acoes {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .acesso {
    position: relative;
  }

  .acesso summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .acesso summary::-webkit-details-marker {
    display: none;
  }

  .acesso summary::after {
    content: "";
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
  }

  .acesso__lista {
    position: absolute;
    right: 50%;
    transform: translateX(50%);
    top: calc(100% + 0.5rem);
    min-width: 220px;
    background: var(--branco);
    border: 1px solid var(--filete);
    border-radius: var(--r-2);
    box-shadow: 0 8px 14px rgb(31 42 47 / 0.08);
    padding: 0.375rem;
  }

  .acesso__lista a {
    display: block;
    padding: 0.625rem 0.75rem;
    border-radius: var(--r-1);
    text-decoration: none;
    font-size: var(--t-14);
  }

  .acesso__lista a:hover {
    background: var(--nevoa);
  }

  .topo__cta {
    min-height: 40px;
    padding: 0.5rem 1rem;
    font-size: var(--t-14);
    /* raio concêntrico ao da pílula: 22 px da pílula - 8 px de respiro = 14 px */
    border-radius: calc(var(--r-1) + clamp(0, var(--r), 1) * 10px);
  }

  .topo__menu {
    display: none;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: var(--r-1);
  }

  .movel {
    border-top: 1px solid var(--filete);
    background: var(--papel);
    padding-block: 1rem 1.5rem;
  }

  .movel ul a {
    display: block;
    padding: 0.75rem 0;
    font-size: var(--t-20);
    font-weight: 600;
    text-decoration: none;
  }

  .movel__rotulo {
    margin-top: 1rem;
    font-size: var(--t-14);
    color: var(--tinta-2);
  }

  .movel__acessos a {
    font-size: var(--t-16) !important;
    font-weight: 500 !important;
    padding: 0.5rem 0 !important;
  }

  .movel .botao {
    margin-top: 1rem;
    width: 100%;
  }

  @media (max-width: 1080px) {
    .topo__nav {
      display: none;
    }
    .topo__menu {
      display: inline-flex;
    }
  }

  @media (max-width: 720px) {
    .topo__cta {
      display: none;
    }
  }

  @media (min-width: 1081px) {
    .movel {
      display: none;
    }
  }
</style>
