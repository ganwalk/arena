---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Etapas from "../components/Etapas.astro";
import Mundo from "../components/Mundo.astro";
import Olimpicas from "../components/Olimpicas.astro";
import Parceiros from "../components/Parceiros.astro";
import Proposta from "../components/Proposta.astro";
import Vida from "../components/Vida.astro";
import Noticias from "../components/Noticias.astro";
import Visita from "../components/Visita.astro";
import Rodape from "../components/Rodape.astro";
---

<Base
  title="Colégio Arena · Goiânia"
  description="Escola em Goiânia da Educação Infantil ao pré-vestibular. Sistema de Ensino Poliedro, turmas olímpicas e a única escola de Goiás membro do College Board."
>
  <Header />
  <main id="conteudo">
    <Hero />
    <Etapas />
    <Mundo />
    <Olimpicas />
    <Parceiros />
    <Proposta />
    <Vida />
    <Noticias />
    <Visita />
  </main>
  <Rodape />
</Base>
